flowchart LR
  A["Guest complaint<br/>form or chat"] --> B["Case created<br/>in CSM"]
  B --> C["Routed to the<br/>right team"]
  C --> D["4-hour timer<br/>starts"]
  D --> E{"Resolved<br/>in time?"}
  E -- No --> F["Automatic<br/>escalation"]
  F --> G
  E -- Yes --> G["Case resolved"]
  G --> H["Guest survey<br/>(CSAT)"]
  B --> I["Recurrence<br/>detection"]
  I --> J["AI groups similar<br/>complaints"]
  J --> K["One Problem<br/>(root cause)"]
  K --> L["Corrective task<br/>for the team"]
  H --> M["Manager dashboard"]
  K --> M
